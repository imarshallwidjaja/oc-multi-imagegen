{
  "name": "oc-multi-imagegen",
  "version": "0.1.0",
  "description": "Image generation and editing tools for OpenCode 1 and OpenCode 2 agents. Uses ChatGPT OAuth through the Codex image backend by default, an OpenAI Images API key through the official API, or a NanoGPT API key with separate generation and editing tools and a model chosen per call.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./server": {
      "import": "./server.js"
    }
  },
  "files": [
    "dist",
    "server.js",
    "skills",
    "docs",
    "!docs/container-testing.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "prebuild": "rm -rf dist",
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --packages external",
    "test": "bun test tests/unit",
    "test:e2e": "bun test tests/e2e/imagegen.test.ts"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "image-generation",
    "image-editing",
    "agent-tools"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@opencode-ai/plugin": "1.19.3",
    "@opencode/plugin": "2.0.32",
    "@tsconfig/node22": "^22.0.2",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "file-type": "^22.0.1",
    "xdg-basedir": "^5.1.0",
    "zod": "^4.2.0"
  }
}
