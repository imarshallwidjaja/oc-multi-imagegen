{
  "name": "oc-multi-imagegen",
  "version": "0.1.0",
  "description": "Image generation and editing tools for OpenCode agents. Currently supports ChatGPT OAuth through the Codex image backend.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "prebuild": "rm -rf dist",
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --packages external",
    "test": "bun test tests/unit",
    "test:e2e": "bun test tests/e2e/imagegen.test.ts"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "image-generation",
    "image-editing",
    "agent-tools"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.14.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@opencode-ai/plugin": "^1.14.41",
    "@tsconfig/node22": "^22.0.2",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "file-type": "^22.0.1",
    "xdg-basedir": "^5.1.0"
  }
}
